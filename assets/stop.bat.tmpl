@echo off
setlocal EnableExtensions
cd /d "%~dp0"

REM 实际端口以 _port.txt 为准（启动时可能因 80 被占用而改用了 8080）
set "PORT={{DEFAULT_PORT}}"
if exist "%~dp0_port.txt" set /p PORT=<"%~dp0_port.txt"

echo 正在停止 {{APP_NAME}} 服务（端口 %PORT%）...

REM ① 先给守护进程一个干净停机的信号，否则它会把子进程重新拉起来
echo stop> "%~dp0_stop.flag"

REM ② 结束守护进程（按命令行识别，避免误杀别的 {{RUNTIME_EXE_NAME}} 程序）
powershell -NoProfile -Command "$w=Get-CimInstance Win32_Process -Filter \"Name='{{RUNTIME_EXE_NAME}}.exe'\" -ErrorAction SilentlyContinue | Where-Object { $_.CommandLine -like '*watchdog.js*' }; if($w){ $w | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue; Write-Host ('stopped watchdog PID ' + $_.ProcessId) } }" 2>nul

REM ③ 按端口精确定位服务进程并结束
powershell -NoProfile -Command "$p=(Get-NetTCPConnection -LocalPort %PORT% -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique); if($p){Stop-Process -Id $p -Force; Write-Host ('killed PID '+$p)} else {Write-Host 'no listener on ' + %PORT%}"

REM ④ 兜底：端口仍未释放时按映像名强杀
ping -n 2 127.0.0.1 >nul
powershell -NoProfile -Command "try { (New-Object Net.Sockets.TcpClient).Connect('127.0.0.1', %PORT%); exit 0 } catch { exit 1 }" >nul 2>nul
if %errorlevel% == 0 (
  echo 端口仍被占用，强制结束 {{RUNTIME_EXE_NAME}}.exe...
  taskkill /f /im {{RUNTIME_EXE_NAME}}.exe >nul 2>nul
  ping -n 2 127.0.0.1 >nul
)

REM ⑤ 清掉停止标志，下次启动才不会被误判
if exist "%~dp0_stop.flag" del /q "%~dp0_stop.flag" >nul 2>nul

echo 服务已停止。
ping -n 3 127.0.0.1 >nul
exit
